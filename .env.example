# Redis 配置（本地使用默认值即可）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_DB=1

# Polymarket CLOB Market Channel（订阅全部 active market asset ids 后接收成交）
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
GAMMA_EVENTS_URL=https://gamma-api.polymarket.com/events/keyset?active=true&closed=false
MARKET_DISCOVERY_PAGE_SIZE=50
MARKET_DISCOVERY_MAX_EVENTS=0
MARKET_DISCOVERY_QUERY_TAG_IDS=102892,102467,102531
MARKET_DISCOVERY_HOURLY_SLUG_DISCOVERY=true
MARKET_DISCOVERY_DAILY_SLUG_DISCOVERY=true
MARKET_REQUIRED_TAG_IDS=1312,101757,102169,21
MARKET_TYPE_TAG_IDS=102127
MARKET_INTERVAL_TAG_IDS=102892,102467,102175,102531,102281
MARKET_ASSET_TAG_IDS=235,39,818,101267,100178,102331,102716
MARKET_WS_SPLIT_BY_ASSET=true
MARKET_WS_ASSET_PARTITIONS=btc-5m:BTC-5M:235:102892,btc-15m:BTC-15M:235:102467,btc-1h:BTC-1H:235:102175,btc-4h:BTC-4H:235:102531,btc-daily:BTC-Daily:235:102281,eth:ETH:39,sol:SOL:818,xrp:XRP:101267,doge:DOGE:100178,hype:HYPE:102331,bnb:BNB:102716
MARKET_DISCOVERY_LIVE_ONLY=true
MARKET_DISCOVERY_API_LIVE=false
MARKET_DISCOVERY_CURRENT_ONLY=true
MARKET_SUBSCRIPTION_BATCH_SIZE=250
MARKET_DISCOVERY_REFRESH_MS=60000
WS_CONNECT_TIMEOUT_MS=30000

# 批处理参数（控制聚合性能）
BATCH_SIZE=50000
BATCH_TIMEOUT_MS=1000

# 日志级别
LOG_LEVEL=info
DEBUG=false

# 是否开启实时事件推送（用于其他服务监听）
ENABLE_STREAMING=true
