# Redis 配置（本地使用默认值即可）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_DB=1

# Polymarket WebSocket 地址（生产环境可保持不变）
POLYMARKET_WS_URL=wss://ws-live-data.polymarket.com

# 批处理参数（控制聚合性能）
BATCH_SIZE=100
BATCH_TIMEOUT_MS=100

# 日志级别
LOG_LEVEL=info
DEBUG=false

# 是否开启实时事件推送（用于其他服务监听）
ENABLE_STREAMING=true